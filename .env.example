# ─────────────────────────────────────────────────────────────────────────────
# Express Insurance dashboard — environment variables
#
# COPY to .env for local dev (`.env` is git-ignored) and set the SAME keys as
# encrypted Environment Variables in the Vercel project (Settings → Environment
# Variables). NEVER commit real values. See docs/CREDENTIALS-AND-ACCESS.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── GA4 (landing-page traffic & engagement ONLY) ──
# GA4 property = the marketing site "Express Insurance Brokers Pty Ltd 2.0" (387516214).
# NOTE: 358319621 is the legacy quote-app property (no marketing landing pages) — do NOT use it.
GA4_PROPERTY_ID=387516214
# Preferred: reuse the existing project's separate service-account variables.
# (Paste the private key exactly; literal \n are normalised in code.)
GA4_SA_EMAIL=
GA4_SA_PRIVATE_KEY=
# ...OR a full service-account key JSON (raw on one line, or base64):
# GOOGLE_SERVICE_ACCOUNT_JSON=
# ...OR a key file path (local dev only):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# The service account must have "Viewer" on the GA4 property above.
# Optional: override the landing page the GA4 report filters on (BEGINS_WITH), if the
# path in GA4 differs from the default accountants page.
# GA4_LANDING_PAGE_PATH=/professional-indemnity-insurance/accountants-insurance
# Optional: channel-group dimension. Set to sessionPrimaryChannelGroup to match GA4's
# "Session primary channel group" report; default is sessionDefaultChannelGroup.
# GA4_CHANNEL_DIMENSION=sessionPrimaryChannelGroup

# ── Google Ads (conversions, conversion value, ROAS, geography — SOURCE OF TRUTH) ──
# NOTE: the live deployment's refresh token is currently INVALID ("invalid_grant").
# Regenerate GOOGLE_ADS_REFRESH_TOKEN via the OAuth playground and update it here.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=          # digits only, no dashes (Express Insurance account)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # optional: MCC/manager account id if used
# Optional precise mapping of live campaign names to dashboard keys, e.g.
# GOOGLE_ADS_CAMPAIGN_MAP={"Brand - AU":"brand","PMax - All Products":"pmax"}
GOOGLE_ADS_CAMPAIGN_MAP=

# ── Report password gate (client-side only; NOT real security) ──
# The gate in index.html stores a djb2 hash, not the password. It is a light
# "shared password" barrier only. Do not treat it as access control.
