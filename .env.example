# ─────────────────────────────────────────────────────────────────────────────
# Express Insurance dashboard — environment variables
#
# COPY to .env for local dev (`.env` is git-ignored) and set the SAME keys as
# encrypted Environment Variables in the Vercel project (Settings → Environment
# Variables). NEVER commit real values. See docs/CREDENTIALS-AND-ACCESS.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── GA4 (landing-page traffic & engagement ONLY) ──
# GA4 property is confirmed live on the current deployment as 358319621.
GA4_PROPERTY_ID=358319621
# Service-account key JSON (raw JSON on one line, or base64). The service account
# must have "Viewer" on the GA4 property above.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or instead point to a key file (local dev only):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ── Google Ads (conversions, conversion value, ROAS, geography — SOURCE OF TRUTH) ──
# NOTE: the live deployment's refresh token is currently INVALID ("invalid_grant").
# Regenerate GOOGLE_ADS_REFRESH_TOKEN via the OAuth playground and update it here.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=          # digits only, no dashes (Express Insurance account)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=    # optional: MCC/manager account id if used
# Optional precise mapping of live campaign names to dashboard keys, e.g.
# GOOGLE_ADS_CAMPAIGN_MAP={"Brand - AU":"brand","PMax - All Products":"pmax"}
GOOGLE_ADS_CAMPAIGN_MAP=

# ── Report password gate (client-side only; NOT real security) ──
# The gate in index.html stores a djb2 hash, not the password. It is a light
# "shared password" barrier only. Do not treat it as access control.
